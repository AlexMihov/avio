/* Node-side code: connectors and the data build CLI. Never bundled into the app. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Everything here runs through tsx or vitest. Emitting would drop .js next to each .ts,
    // and Vite resolves .js first, so a stray build would shadow the real source.
    "noEmit": true,
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["shared/**/*.ts", "sources/**/*.ts", "tools/**/*.ts"]
}
